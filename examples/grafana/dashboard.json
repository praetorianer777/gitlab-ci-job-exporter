{
  "title": "CI job durations",
  "uid": "gitlab-ci-job-exporter",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "tags": [
    "ci",
    "gitlab"
  ],
  "panels": [
    {
      "type": "table",
      "title": "Per project and job",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (project, job) (increase(ci_job_duration_seconds_sum{project=~\"$project\", runner=~\"$runner\"}[$__range])) / sum by (project, job) (increase(ci_job_duration_seconds_count{project=~\"$project\", runner=~\"$runner\"}[$__range]))",
          "refId": "A",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.9, sum by (project, job, le) (increase(ci_job_duration_seconds_bucket{project=~\"$project\", runner=~\"$runner\"}[$__range])))",
          "refId": "B",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (project, job) (increase(ci_job_queued_seconds_sum{project=~\"$project\", runner=~\"$runner\"}[$__range])) / sum by (project, job) (increase(ci_job_queued_seconds_count{project=~\"$project\", runner=~\"$runner\"}[$__range]))",
          "refId": "C",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (project, job) (increase(ci_job_duration_seconds_count{project=~\"$project\", runner=~\"$runner\"}[$__range]))",
          "refId": "D",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (project, job) (increase(ci_job_duration_seconds_count{project=~\"$project\", runner=~\"$runner\", status=\"failed\"}[$__range])) / sum by (project, job) (increase(ci_job_duration_seconds_count{project=~\"$project\", runner=~\"$runner\"}[$__range]))",
          "refId": "E",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "job",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Average duration",
              "Value #B": "p90 duration",
              "Value #C": "Average queue time",
              "Value #D": "Runs",
              "Value #E": "Failure rate"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Average duration|p90 duration|Average queue time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failure rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Runs"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Average duration",
            "desc": true
          }
        ]
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Average duration per job",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (project, job) (increase(ci_job_duration_seconds_sum{project=~\"$project\", runner=~\"$runner\"}[$__rate_interval])) / sum by (project, job) (increase(ci_job_duration_seconds_count{project=~\"$project\", runner=~\"$runner\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{project}} / {{job}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Average queue time per runner",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (runner) (increase(ci_job_queued_seconds_sum{project=~\"$project\", runner=~\"$runner\"}[$__rate_interval])) / sum by (runner) (increase(ci_job_queued_seconds_count{project=~\"$project\", runner=~\"$runner\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{runner}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Failures per job",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (project, job) (increase(ci_job_duration_seconds_count{project=~\"$project\", runner=~\"$runner\", status=\"failed\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{project}} / {{job}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Waiting jobs by runner tag",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (tags) (ci_jobs_pending{project=~\"$project\"})",
          "refId": "A",
          "legendFormat": "{{tags}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Pipelines waiting",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(ci_pipelines_pending{project=~\"$project\"})",
          "refId": "A",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "id": 6
    },
    {
      "type": "stat",
      "title": "Open issues",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 28,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(ci_project_open_issues{project=~\"$project\"})",
          "refId": "A",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "id": 7
    },
    {
      "type": "stat",
      "title": "Open merge requests",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(ci_project_open_merge_requests{project=~\"$project\"})",
          "refId": "A",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "id": 8
    },
    {
      "type": "table",
      "title": "Open issues and merge requests per project",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ci_project_open_issues{project=~\"$project\"}",
          "refId": "A",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ci_project_open_merge_requests{project=~\"$project\"}",
          "refId": "B",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "project",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true
            },
            "renameByName": {
              "Value #A": "Open issues",
              "Value #B": "Open merge requests"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Open merge requests",
            "desc": true
          }
        ]
      },
      "id": 9
    },
    {
      "type": "stat",
      "title": "Oldest open merge request",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(ci_merge_request_oldest_open_seconds{project=~\"$project\"})",
          "refId": "A",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "id": 10
    },
    {
      "type": "stat",
      "title": "Open issues without an assignee",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 40,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(ci_issues_unassigned{project=~\"$project\"})",
          "refId": "A",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Open merge requests by state",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (state) (ci_merge_requests_open_by_state{project=~\"$project\"})",
          "refId": "A",
          "legendFormat": "{{state}}",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Time to merge, p50 and p90",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (increase(ci_merge_request_time_to_merge_seconds_bucket{project=~\"$project\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "p50",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (increase(ci_merge_request_time_to_merge_seconds_bucket{project=~\"$project\"}[$__rate_interval])))",
          "refId": "B",
          "legendFormat": "p90",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 13
    },
    {
      "type": "table",
      "title": "Oldest open merge request per project",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ci_merge_request_oldest_open_seconds{project=~\"$project\"}",
          "refId": "A",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Age"
            }
          }
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "Age",
            "desc": true
          }
        ]
      },
      "id": 14
    },
    {
      "type": "table",
      "title": "Most retried jobs",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(20, sum by (project, job) (increase(ci_job_retried_total{project=~\"$project\"}[$__range])))",
          "refId": "A",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (project, job) (increase(ci_job_retry_passed_total{project=~\"$project\"}[$__range]))",
          "refId": "B",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true
            },
            "renameByName": {
              "Value #A": "Retried",
              "Value #B": "Retry passed"
            }
          }
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "Retried",
            "desc": true
          }
        ]
      },
      "id": 15
    },
    {
      "type": "table",
      "title": "Most failing tests",
      "datasource": {
        "type": "prometheus",
