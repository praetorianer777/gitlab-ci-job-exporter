              },
              {
                "id": "custom.cellOptions",
                "value": {}
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "milestone",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true
            },
            "renameByName": {
              "Value #A": "Open issues",
              "Value #B": "Due"
            }
          }
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "Due"
          }
        ]
      },
      "id": 18
    },
    {
      "type": "bargauge",
      "title": "Storage per project",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 75,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort_desc(sum by (project) (ci_project_storage_bytes{project=~\"$project\"}))",
          "refId": "A",
          "legendFormat": "{{project}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
