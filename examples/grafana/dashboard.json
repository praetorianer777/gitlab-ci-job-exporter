        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * sum by (milestone) (ci_milestone_issues{state=\"closed\"}) / sum by (milestone) (ci_milestone_issues)",
          "refId": "A",
          "legendFormat": "{{milestone}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "id": 17
    },
    {
      "type": "table",
      "title": "Milestones by due date",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 66,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (milestone) (ci_milestone_issues{state=\"opened\"})",
          "refId": "A",
          "legendFormat": "",
          "format": "table",
